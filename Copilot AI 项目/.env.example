# 向量数据库的配置
milvus_uri=http://192.168.110.211:19530
milvus_db_name=tool_db
# MongoDB数据库的配置
mongo_host=127.0.0.1
mongo_db=tools
mongo_port=27112
api_result_max_length=30000
api_result_max_threshold=0.1
milvus_similarity_threshold=0.35
# 大模型（LLM、向量模型、重排序模型等等）的相关配置
topK=5
model_path=model
#model_name填写你的模型名称
model_name=qwen3.7-plus
model_top_p=0.01
# model_api_key填写你的模型api key
model_api_key=
# model_base_url填写你的模型访问URL地址
model_base_url=
# sim_api_key填写云服务器的api key
sim_api_key=
# 内部安全配置
SECRET_KEY = zhipo_copilot@zhipo.com
JWT_ALGORITHM = 'HS256'
# 本地开发配置
local_mode=1

# ===== Judge 模型配置（评估用，独立于主模型以防止自审偏差）=====
# 不配置时 --with-judge 自动降级为仅运行程序化指标
# 推荐：qwen-max 主模型 → deepseek-chat 做 Judge（不同模型族）
# 备选：qwen-max 主模型 → glm-4-flash 做 Judge（不同模型族，中文理解好）
# 注意：不推荐用与主模型相同的模型族做 Judge（自评偏差）
judge_api_key=
judge_base_url=
judge_model=
judge_temperature=0.0
judge_top_p=0.1
