# ── 环境变量模板 ──
# 复制此文件为 .env 后填入真实值
# 本地开发（无 Docker）可直接复制到 src/backend/.env

# ═══ 必填：云端 API 密钥 ═══

# 通义千问 DashScope API Key
# 获取: https://dashscope.console.aliyun.com/apiKey
# 作用: LLM 问答 / Embedding 向量化 / Rerank 精排 / 元数据提取
DASHSCOPE_API_KEY=XX

# MinerU 云端文档解析 Token
# 获取: https://mineru.net/apiManage/token
# 作用: PDF/图片结构化解析（不配则降级 PyMuPDF 本地提取）
MINERU_API_TOKEN=

# ═══ 可选：本地基础设施（不配置则自动降级）═══

# PostgreSQL 关系数据库（元数据持久化）
# 不配置/不可用时: 文档元数据仅存内存
DATABASE_URL=postgresql+asyncpg://user:XX@localhost:5432/building_docs

# Redis（Celery 任务队列 / 缓存）
# 不配置/不可用时: 异步任务不可用，同步流程正常
REDIS_URL=redis://localhost:6379/0

# ChromaDB 向量数据库
# 不配置/不可用时: 自动切换嵌入式持久化模式（data/chroma/）
# 注意: 若本地运行 Chroma 容器，映射端口 8002:8000 则填 8002
CHROMA_HOST=localhost
CHROMA_PORT=8002

# MinIO 对象存储（原始文件/解析结果）
# 不配置/不可用时: 自动降级本地 data/uploads/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=XX
MINIO_SECRET_KEY=XX
MINIO_BUCKET=building-docs

# ═══ 可选：Embedding 本地模型 ═══

# BGE-M3 本地模型（需先 pip install sentence-transformers）
# 未安装/不可用时: 自动降级 DashScope 云端 text-embedding-v3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu   # 有 NVIDIA GPU 且 CUDA 可用时改为 cuda

# ═══ 安全（生产环境务必修改）═══

JWT_SECRET=XX
